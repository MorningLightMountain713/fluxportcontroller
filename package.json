{
  "name": "@megachips/fluxport-controller",
  "version": "0.1.1",
  "main": "build/src/index",
  "files": [
    "/build"
  ],
  "author": "David White <https://github.com/MorningLightMountain713>",
  "homepage": "https://github.com/MorningLightMountain713/fluxport-controller",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "http://github.com/MorningLightMountain713/fluxport-controller.git"
  },
  "scripts": {
    "build": "tsc",
    "prepare": "npm run build",
    "watch": "tsc --watch",
    "unittest": "node --import tsx --test test/unit/*.spec.ts test/unit/consensus/*.spec.ts test/unit/upnp/*.spec.ts",
    "inttest": "node --import tsx --test test/integration/*.int.spec.ts",
    "inttest:chaos": "node --import tsx --test test/integration/chaos.int.spec.ts",
    "inttest:upnp": "node --import tsx --test test/integration/upnp.int.spec.ts",
    "start": "node --import tsx test_docker_entrypoint.ts"
  },
  "bin": {
    "fpc": "test_entrypoint.ts"
  },
  "keywords": [
    "nat",
    "upnp",
    "flux"
  ],
  "devDependencies": {
    "@types/node": "^26.6.6",
    "testcontainers": "^12.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@runonflux/nat-upnp": "^3.0.0",
    "axios": "^1.21.1",
    "winston": "^3.19.0"
  }
}
